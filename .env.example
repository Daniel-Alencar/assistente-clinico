# Copie para .env.local e preencha. Nunca versione o .env.local.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Segredo usado pelo agendador (Vercel Cron) para chamar /api/cron/*
CRON_SECRET=troque-por-um-valor-aleatorio

# --- Supabase (crie o projeto na região South America / São Paulo) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Project Settings > API Keys: chave "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave "secret" (sb_secret_...). Somente no servidor (webhooks e cron). Nunca exponha no navegador.
SUPABASE_SECRET_KEY=

# --- IA (geração da evolução clínica) ---
# Provedor ativo: "anthropic" ou "gemini"
IA_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Gemini: camada gratuita só com dados fictícios (o Google pode usar os dados para treino)
GEMINI_API_KEY=
# Opcional: modelo preferido (há reserva automática se estiver sobrecarregado)
GEMINI_MODEL=gemini-3.5-flash

# --- WhatsApp ---
# Provedor ativo: "console" (só loga, para dev), "evolution" (teste) ou "meta" (produção)
WHATSAPP_PROVIDER=console

# Meta Cloud API (oficial)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=troque-por-um-valor-aleatorio
META_GRAPH_API_VERSION=v23.0

# Evolution API (apenas protótipo / testes)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=assistente-clinico

# --- Assinatura da plataforma (Mercado Pago) ---
# Conta do DONO do Assistente Clínico: recebe as mensalidades dos profissionais.
# (As sessões dos pacientes são pagas por Pix direto na chave de cada profissional.)
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta configurada em "Webhooks" no painel do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=
# Preço mensal do plano, em reais
NEXT_PUBLIC_PRECO_MENSAL=49

# --- Limites ---
# Usos de IA (evolução + apoio ao diagnóstico) por profissional a cada 24h
LIMITE_IA_DIARIO=40
